{
  "name": "@nivashr/vue-hotel-datepicker",
  "version": "3.0.0",
  "description": "A customizable hotel date-picker component for Vue 3 (forked and improved)",
  "main": "lib/vue-hotel-datepicker.umd.js",
  "module": "lib/vue-hotel-datepicker.mjs",
  "unpkg": "lib/vue-hotel-datepicker.umd.js",
  "exports": {
    ".": {
      "import": "./lib/vue-hotel-datepicker.mjs",
      "require": "./lib/vue-hotel-datepicker.umd.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/index.js",
    "src/components",
    "src/utils"
  ],
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build",
    "build:demo": "vite build --config vite.demo.config.mjs",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build:lib"
  },
  "author": "NIVAS (https://nivas.hr)",
  "contributors": [
    {
      "name": "Northwalker (original author)",
      "url": "https://github.com/northwalker"
    },
    {
      "name": "Neven Jacmenović",
      "url": "https://github.com/guycalledseven"
    },
    {
      "name": "Rudolf Jozanović",
      "url": "https://github.com/nivas"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nivas/vue-hotel-datepicker.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "datepicker",
    "date picker",
    "date range picker",
    "hotel datepicker",
    "vue datepicker",
    "vue hotel datepicker"
  ],
  "bugs": {
    "url": "https://github.com/nivas/vue-hotel-datepicker/issues"
  },
  "homepage": "https://github.com/nivas/vue-hotel-datepicker#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "sass": "^1.105.1",
    "vite": "^8.3.2",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  }
}
